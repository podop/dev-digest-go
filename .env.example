# Copy to .env (git-ignored). Everything is optional; unset variables use the defaults shown.
# docker compose reads this file for ${VAR} substitution and passes it to the backend container.

# Host ports (loopback). Defaults avoid the Node DevDigest stack on 3000/3001/5432.
# NEXT_PUBLIC_API_BASE is baked into the frontend image: changing API_PORT needs
# `docker compose up -d --build frontend`.
WEB_PORT=3100
API_PORT=3101
DB_PORT=5433

# Backend log level: debug | info | warn | error.
LOG_LEVEL=info

# Backend switches (only the literal value `false` turns a switch off).
# Apply pending SQL migrations before the server starts listening.
DB_AUTO_MIGRATE=true
# Run the idempotent seed (demo repo, PRs, default settings) after migrating.
DB_AUTO_SEED=true
# Fixed-window rate limiting per client IP (120 req/60 s; 20/60 s for POST /settings/test-connection).
RATE_LIMIT_ENABLED=true
# Repo-intel read port (repo map, symbol and import lookups used by the conventions sampler).
# `false` makes the port answer "flag_off"/empty; indexing and GET /repos/:id/index-state are unaffected.
REPO_INTEL_ENABLED=true
# Host names the API answers to (DNS-rebinding guard; port ignored). Anything else gets 403.
# Add a name here if you reach the API under another host name.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend

# LLM provider override: empty uses the real providers (keys below); `mock` replaces every
# provider by a deterministic mock that needs no key and makes no network call (the backend
# logs a warning at startup). Any other value stops the backend from starting.
LLM_PROVIDER_OVERRIDE=
# Delay of each mock LLM call in milliseconds (integer 0-60000); only used with the mock.
LLM_MOCK_DELAY_MS=0
# Files shown as project context: comma-separated globs (commas inside {...} stay part of the
# glob). Empty uses the default **/{specs,docs,insights}/**/*.md.
PROJECT_CONTEXT_GLOBS=

# Reviews: how many agents of one review request run at once (integer 1-20) and how many
# map-reduce chunks of one agent run are in flight at once (integer 1-16). Empty uses the default.
# Any other value stops the backend from starting.
REVIEW_AGENT_CONCURRENCY=4
REVIEW_MAP_CONCURRENCY=3

# Fixed inside the container, not configurable here: DEVDIGEST_DATA_DIR=/data (named volume
# devdigest_go_backend_data) holds secrets.json and the clone root /data/workspace.

# LLM providers and GitHub. Leave empty if unset; a key saved in Settings (stored in
# /data/secrets.json) takes precedence over these. Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
# Fallback used only when GITHUB_TOKEN is empty.
GITHUB_PAT=
