# Copy to .env (git-ignored). Everything is optional.

# Host ports (loopback). Defaults avoid the Node DevDigest stack on 3000/3001/5432.
WEB_PORT=3100
API_PORT=3101
DB_PORT=5433

# Passed to the backend container.
LOG_LEVEL=info
# LLM providers and GitHub — used once the matching backend modules are migrated.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
