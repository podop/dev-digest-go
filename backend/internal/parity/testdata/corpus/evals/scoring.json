{
  "expect": {
    "mf": { "kind": "must_find", "file": "src/a.ts", "start_line": 10, "end_line": 12, "severity": "WARNING", "category": "bug", "title": "T" },
    "mnf": { "kind": "must_not_flag", "file": "src/a.ts", "start_line": 10, "end_line": 12, "severity": null, "category": null, "title": null }
  },
  "findingBase": { "file": "src/a.ts", "start_line": 10, "end_line": 12, "severity": "WARNING", "category": "bug", "title": "Found" },
  "score": [
    { "name": "must_find with no findings fails", "expect": "mf", "kept": [] },
    { "name": "must_not_flag with no findings passes", "expect": "mnf", "kept": [] },
    { "name": "must_find exact hit", "expect": "mf", "kept": [{}] },
    { "name": "must_not_flag exact violation", "expect": "mnf", "kept": [{}] },
    { "name": "must_find touching start", "expect": "mf", "kept": [{ "start_line": 1, "end_line": 10 }] },
    { "name": "must_find touching end", "expect": "mf", "kept": [{ "start_line": 12, "end_line": 20 }] },
    { "name": "must_find just before", "expect": "mf", "kept": [{ "start_line": 1, "end_line": 9 }] },
    { "name": "must_find just after", "expect": "mf", "kept": [{ "start_line": 13, "end_line": 20 }] },
    { "name": "reversed finding range intersects", "expect": "mf", "kept": [{ "start_line": 11, "end_line": 5 }] },
    { "name": "reversed finding range misses", "expect": "mf", "kept": [{ "start_line": 9, "end_line": 1 }] },
    { "name": "reversed expectation range intersects", "expect": "mf", "expectOverride": { "start_line": 12, "end_line": 10 }, "kept": [{ "start_line": 11, "end_line": 11 }] },
    { "name": "reversed expectation range misses", "expect": "mf", "expectOverride": { "start_line": 12, "end_line": 10 }, "kept": [{ "start_line": 13, "end_line": 14 }] },
    { "name": "other file never matches", "expect": "mf", "kept": [{ "file": "src/b.ts" }] },
    { "name": "file match is exact", "expect": "mf", "kept": [{ "file": "src/A.ts" }, { "file": "a.ts" }, { "file": "src/a.ts " }] },
    { "name": "two hits count twice", "expect": "mf", "kept": [{ "title": "one" }, { "title": "two", "start_line": 11, "end_line": 11 }] },
    { "name": "hit and unlabeled", "expect": "mf", "kept": [{ "title": "hit" }, { "title": "other", "file": "src/z.ts" }] },
    { "name": "violation and unlabeled", "expect": "mnf", "kept": [{ "title": "viol" }, { "title": "other", "start_line": 40, "end_line": 41 }] },
    { "name": "must_not_flag with only unlabeled passes", "expect": "mnf", "kept": [{ "start_line": 40, "end_line": 41 }, { "file": "src/z.ts" }] },
    { "name": "two violations", "expect": "mnf", "kept": [{}, { "start_line": 12, "end_line": 12 }] },
    { "name": "null severity category title", "expect": "mf", "kept": [{ "severity": null, "category": null, "title": null }] },
    { "name": "order is preserved", "expect": "mf", "kept": [{ "title": "z", "file": "z" }, { "title": "m" }, { "title": "a", "file": "a" }] },
    { "name": "single line expectation", "expect": "mf", "expectOverride": { "start_line": 5, "end_line": 5 }, "kept": [{ "start_line": 5, "end_line": 5 }, { "start_line": 4, "end_line": 4 }, { "start_line": 6, "end_line": 6 }] },
    { "name": "huge line numbers", "expect": "mf", "expectOverride": { "start_line": 2147483646, "end_line": 2147483647 }, "kept": [{ "start_line": 2147483647, "end_line": 2147483647 }] }
  ],
  "outcomeBase": { "kind": "must_find", "status": "passed", "hit_count": 1, "violation_count": 0, "unlabeled_count": 0, "dropped_count": 0, "cost_usd": null, "error": null },
  "aggregate": [
    { "name": "no outcomes", "outcomes": [] },
    { "name": "one passed must_find", "outcomes": [{}] },
    { "name": "one failed must_find", "outcomes": [{ "status": "failed", "hit_count": 0 }] },
    { "name": "one passed must_not_flag", "outcomes": [{ "kind": "must_not_flag", "hit_count": 0 }] },
    { "name": "one failed must_not_flag", "outcomes": [{ "kind": "must_not_flag", "status": "failed", "hit_count": 0, "violation_count": 2 }] },
    { "name": "only must_not_flag: recall null", "outcomes": [{ "kind": "must_not_flag", "hit_count": 0 }, { "kind": "must_not_flag", "hit_count": 0, "unlabeled_count": 1 }] },
    { "name": "only must_find failing: precision null", "outcomes": [{ "status": "failed", "hit_count": 0 }, { "status": "failed", "hit_count": 0 }] },
    { "name": "all error", "outcomes": [{ "status": "error", "hit_count": 0, "error": "boom" }, { "status": "error", "hit_count": 0, "error": "bang", "cost_usd": 0.01 }] },
    { "name": "error cases do not count toward metrics", "outcomes": [{}, { "status": "error", "hit_count": 5, "violation_count": 5, "unlabeled_count": 5, "dropped_count": 5, "error": "x", "cost_usd": 0.5 }] },
    { "name": "citation accuracy from drops", "outcomes": [{ "dropped_count": 3 }] },
    { "name": "citation accuracy no findings kept all dropped", "outcomes": [{ "status": "failed", "hit_count": 0, "dropped_count": 4 }] },
    { "name": "zero kept zero dropped", "outcomes": [{ "status": "failed", "hit_count": 0 }] },
    { "name": "unlabeled findings summed", "outcomes": [{ "unlabeled_count": 2 }, { "unlabeled_count": 3, "status": "failed", "hit_count": 0 }, { "kind": "must_not_flag", "hit_count": 0, "unlabeled_count": 1 }] },
    { "name": "recall two thirds", "outcomes": [{}, {}, { "status": "failed", "hit_count": 0 }] },
    { "name": "recall one third", "outcomes": [{}, { "status": "failed", "hit_count": 0 }, { "status": "failed", "hit_count": 0 }] },
    { "name": "precision tie at four decimals 1/32", "outcomes": [{ "hit_count": 1, "violation_count": 31, "kind": "must_not_flag", "status": "failed" }] },
    { "name": "precision tie at four decimals 3/32", "outcomes": [{ "hit_count": 3, "violation_count": 29, "kind": "must_not_flag", "status": "failed" }] },
    { "name": "precision 1/3", "outcomes": [{ "hit_count": 1, "violation_count": 2, "kind": "must_not_flag", "status": "failed" }] },
    { "name": "precision 2/3", "outcomes": [{ "hit_count": 2, "violation_count": 1, "kind": "must_not_flag", "status": "failed" }] },
    { "name": "citation 1/3", "outcomes": [{ "hit_count": 1, "dropped_count": 2 }] },
    { "name": "citation 7/8", "outcomes": [{ "hit_count": 7, "dropped_count": 1 }] },
    { "name": "costs summed", "outcomes": [{ "cost_usd": 0.1 }, { "cost_usd": 0.2 }, { "cost_usd": 0.3 }] },
    { "name": "cost with a null case", "outcomes": [{ "cost_usd": 0.001234 }, { "cost_usd": null }, { "status": "error", "hit_count": 0, "error": "e", "cost_usd": 0.0005 }] },
    { "name": "cost zero is a cost", "outcomes": [{ "cost_usd": 0 }] },
    { "name": "all costs null", "outcomes": [{}, {}] },
    { "name": "cost tie at six decimals", "outcomes": [{ "cost_usd": 0.0000005 }] },
    { "name": "cost sum with float noise", "outcomes": [{ "cost_usd": 0.0000001 }, { "cost_usd": 0.0000002 }, { "cost_usd": 0.0000003 }, { "cost_usd": 0.1234565 }] },
    { "name": "mixed run", "outcomes": [
      { "hit_count": 1, "unlabeled_count": 1, "dropped_count": 1, "cost_usd": 0.0123 },
      { "status": "failed", "hit_count": 0, "unlabeled_count": 2, "cost_usd": 0.0111 },
      { "kind": "must_not_flag", "hit_count": 0, "cost_usd": 0.0099 },
      { "kind": "must_not_flag", "status": "failed", "hit_count": 0, "violation_count": 1, "cost_usd": null },
      { "status": "error", "hit_count": 0, "error": "Case timed out after 120s", "cost_usd": 0.02 }
    ] }
  ],
  "random": { "seed": 6006, "runs": 40, "maxCases": 12 },
  "verdict": [
    { "name": "no outcomes is completed", "outcomes": [] },
    { "name": "one passed", "outcomes": [{}] },
    { "name": "one error is failed with its text", "outcomes": [{ "status": "error", "error": "boom" }] },
    { "name": "all errored: first error text", "outcomes": [{ "status": "error", "error": "first" }, { "status": "error", "error": "second" }] },
    { "name": "all errored: first non-empty text", "outcomes": [{ "status": "error", "error": null }, { "status": "error", "error": "second" }] },
    { "name": "all errored: empty text is skipped", "outcomes": [{ "status": "error", "error": "" }, { "status": "error", "error": "third" }] },
    { "name": "all errored without any text", "outcomes": [{ "status": "error", "error": null }, { "status": "error", "error": "" }] },
    { "name": "one passed one error is completed", "outcomes": [{ "status": "error", "error": "x" }, {}] },
    { "name": "one failed one error is completed", "outcomes": [{ "status": "error", "error": "x" }, { "status": "failed", "hit_count": 0 }] }
  ]
}
