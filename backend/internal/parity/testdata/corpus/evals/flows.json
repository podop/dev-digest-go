{
  "validation": [
    { "schema": "EvalRunListQuery", "inputs": [
      {}, { "limit": "5" }, { "limit": "0" }, { "limit": "1" }, { "limit": "100" }, { "limit": "101" }, { "limit": "abc" }, { "limit": "2.5" },
      { "limit": "" }, { "limit": " 7 " }, { "limit": "1e1" }, { "limit": "0x10" }, { "limit": "-1" }, { "limit": 5 }, { "limit": null },
      { "period": "7d" }, { "period": "30d" }, { "period": "90d" }, { "period": "all" }, { "period": "1d" }, { "period": "" }, { "period": "7D" },
      { "limit": "20", "period": "all" }, { "limit": "x", "period": "y" }, { "extra": "ignored" }
    ] },
    { "schema": "EvalCompareQuery", "inputs": [
      { "a": "x", "b": "y" }, { "a": "", "b": "y" }, { "a": "x", "b": "" }, { "a": "x" }, {}, { "a": 1, "b": 2 }, { "a": "not-a-uuid", "b": "also-not" }
    ] },
    { "schema": "EvalSkillRunStartInput", "inputs": [
      { "agent_id": "3f2b8c1e-9d4a-4b7e-8c1a-2d3e4f5a6b7c" }, { "agent_id": "3F2B8C1E-9D4A-4B7E-8C1A-2D3E4F5A6B7C" }, { "agent_id": "not-a-uuid" },
      { "agent_id": "" }, { "agent_id": null }, {}, { "agent_id": "3f2b8c1e9d4a4b7e8c1a2d3e4f5a6b7c" }, { "agent_id": "{3f2b8c1e-9d4a-4b7e-8c1a-2d3e4f5a6b7c}" },
      { "agent_id": "00000000-0000-0000-0000-000000000000" }, { "agent_id": " 3f2b8c1e-9d4a-4b7e-8c1a-2d3e4f5a6b7c" }
    ] },
    { "schema": "EvalAgentDashboardQuery", "inputs": [{}, { "period": "30d" }, { "period": "all" }, { "period": "x" }, { "period": "" }, { "period": 7 }] }
  ],
  "casesService": [
    { "name": "createFromFinding creates the case and logs once",
      "world": { "findings": { "f-1": {} } },
      "steps": [{ "op": "createFromFinding", "findingId": "f-1" }] },
    { "name": "createFromFinding of a dismissed finding",
      "world": { "findings": { "f-2": { "decision": "dismissed", "findingId": "f-2" } } },
      "steps": [{ "op": "createFromFinding", "findingId": "f-2" }] },
    { "name": "createFromFinding: unknown finding is 404",
      "world": { "findings": {} },
      "steps": [{ "op": "createFromFinding", "findingId": "nope" }] },
    { "name": "createFromFinding: a case already exists",
      "world": { "findings": { "f-1": {} }, "casesByFinding": { "f-1": "case-existing" } },
      "steps": [{ "op": "createFromFinding", "findingId": "f-1" }] },
    { "name": "createFromFinding: existing case is checked before the decision",
      "world": { "findings": { "f-1": { "decision": null } }, "casesByFinding": { "f-1": "case-existing" } },
      "steps": [{ "op": "createFromFinding", "findingId": "f-1" }] },
    { "name": "createFromFinding: undecided",
      "world": { "findings": { "f-1": { "decision": null } } },
      "steps": [{ "op": "createFromFinding", "findingId": "f-1" }] },
    { "name": "createFromFinding: no agent / no patch / patch too large",
      "world": { "findings": { "f-1": { "agentId": null }, "f-2": { "patch": null }, "f-3": { "patch": { "$repeat": ["x", 200001] } } } },
      "steps": [{ "op": "createFromFinding", "findingId": "f-1" }, { "op": "createFromFinding", "findingId": "f-2" }, { "op": "createFromFinding", "findingId": "f-3" }] },
    { "name": "createFromFinding: owner at the limit",
      "world": { "findings": { "f-1": {} }, "counts": { "agent:a-1": 200 } },
      "steps": [{ "op": "createFromFinding", "findingId": "f-1" }] },
    { "name": "createFromFinding: one below the limit",
      "world": { "findings": { "f-1": {} }, "counts": { "agent:a-1": 199 } },
      "steps": [{ "op": "createFromFinding", "findingId": "f-1" }] },
    { "name": "createFromFinding: lost the insert race",
      "world": { "findings": { "f-1": {} }, "insertRace": true },
      "steps": [{ "op": "createFromFinding", "findingId": "f-1" }] },
    { "name": "create: agent owner",
      "world": { "agents": ["agent-1"] },
      "steps": [{ "op": "create", "owner": { "kind": "agent", "id": "agent-1" }, "body": { "name": "Manual", "expectation": { "kind": "must_find", "file": "src/a.ts", "start_line": 9, "end_line": 9 }, "input_diff": { "$diff": "single" } } }] },
    { "name": "create: skill owner",
      "world": { "skills": ["skill-1"] },
      "steps": [{ "op": "create", "owner": { "kind": "skill", "id": "skill-1" }, "body": { "name": "Manual", "expectation": { "kind": "must_not_flag", "file": "src/a.ts", "start_line": 9, "end_line": 9 }, "input_diff": "@@ -8,1 +8,2 @@\n x\n+y" } }] },
    { "name": "create: unknown agent and unknown skill",
      "world": { "agents": [], "skills": [] },
      "steps": [
        { "op": "create", "owner": { "kind": "agent", "id": "nope" }, "body": { "name": "M", "expectation": { "kind": "must_find", "file": "src/a.ts", "start_line": 9, "end_line": 9 }, "input_diff": { "$diff": "single" } } },
        { "op": "create", "owner": { "kind": "skill", "id": "nope" }, "body": { "name": "M", "expectation": { "kind": "must_find", "file": "src/a.ts", "start_line": 9, "end_line": 9 }, "input_diff": { "$diff": "single" } } }
      ] },
    { "name": "create: owner is checked before the content, content before the limit",
      "world": { "agents": ["agent-1"], "counts": { "agent:agent-1": 200 } },
      "steps": [
        { "op": "create", "owner": { "kind": "agent", "id": "nope" }, "body": { "name": "M", "expectation": { "kind": "must_find", "file": "src/zzz.ts", "start_line": 9, "end_line": 9 }, "input_diff": { "$diff": "single" } } },
        { "op": "create", "owner": { "kind": "agent", "id": "agent-1" }, "body": { "name": "M", "expectation": { "kind": "must_find", "file": "src/zzz.ts", "start_line": 9, "end_line": 9 }, "input_diff": { "$diff": "single" } } },
        { "op": "create", "owner": { "kind": "agent", "id": "agent-1" }, "body": { "name": "M", "expectation": { "kind": "must_find", "file": "src/a.ts", "start_line": 9, "end_line": 9 }, "input_diff": { "$diff": "single" } } }
      ] },
    { "name": "create: invalid bodies never reach the service",
      "world": { "agents": ["agent-1"] },
      "steps": [{ "op": "create", "owner": { "kind": "agent", "id": "agent-1" }, "body": { "name": "", "expectation": { "kind": "must_find", "file": "src/a.ts", "start_line": 9, "end_line": 9 }, "input_diff": "x" } }] },
    { "name": "list: agent, skill, unknown owners",
      "world": { "agents": ["agent-1"], "skills": ["skill-1"], "lists": { "agent:agent-1": [{ "id": "case-1" }, { "id": "case-2" }] } },
      "steps": [{ "op": "list", "owner": { "kind": "agent", "id": "agent-1" } }, { "op": "list", "owner": { "kind": "skill", "id": "skill-1" } }, { "op": "list", "owner": { "kind": "agent", "id": "nope" } }, { "op": "list", "owner": { "kind": "skill", "id": "nope" } }] },
    { "name": "update: unknown case",
      "world": { "stored": {} },
      "steps": [{ "op": "update", "id": "case-9", "patch": { "name": "x" } }] },
    { "name": "update: name only writes the name",
      "world": { "stored": { "case-1": "stored" } },
      "steps": [{ "op": "update", "id": "case-1", "patch": { "name": "Renamed", "notes": "n" } }] },
    { "name": "update: empty patch still goes through the store",
      "world": { "stored": { "case-1": "stored" } },
      "steps": [{ "op": "update", "id": "case-1", "patch": {} }] },
    { "name": "update: content edit that passes the recheck",
      "world": { "stored": { "case-1": "stored" } },
      "steps": [{ "op": "update", "id": "case-1", "patch": { "start_line": 8, "end_line": 12, "severity": null } }] },
    { "name": "update: content edit that fails the recheck writes nothing",
      "world": { "stored": { "case-1": "stored" } },
      "steps": [{ "op": "update", "id": "case-1", "patch": { "file": "src/other.ts" } }, { "op": "update", "id": "case-1", "patch": { "start_line": 400, "end_line": 401 } }] },
    { "name": "update: reversed lines are 400 before the recheck",
      "world": { "stored": { "case-1": "stored" } },
      "steps": [{ "op": "update", "id": "case-1", "patch": { "start_line": 20 } }] },
    { "name": "update: metadata only edits do not recheck the diff",
      "world": { "stored": { "case-1": "stored" } },
      "steps": [{ "op": "update", "id": "case-1", "patch": { "pr_title": "  ", "pr_description": "" } }, { "op": "update", "id": "case-1", "patch": { "kind": "must_not_flag" } }] },
    { "name": "remove: existing and missing",
      "world": { "stored": { "case-1": "stored" } },
      "steps": [{ "op": "remove", "id": "case-1" }, { "op": "remove", "id": "case-9" }] }
  ],
  "executor": {
    "job": {
      "runId": "run-1", "workspaceId": "ws-1", "ownerKind": "agent", "skillId": null, "skillVersion": null, "agentId": "agent-1", "agentVersion": 3, "agentName": "Security Reviewer",
      "config": { "provider": "openrouter", "model": "deepseek/deepseek-v4-flash", "system_prompt": "You are a security reviewer.", "strategy": "single-pass", "skills": [] },
      "caseIds": ["c1"]
    },
    "skills": [
      { "id": "sk-1", "name": "api-safety", "description": "Applies to HTTP handlers", "body": "\n  Check auth on every route.\n", "version": 2 },
      { "id": "sk-2", "name": "no-secrets", "description": "  ", "body": "Never commit keys.", "version": 1 }
    ],
    "expect": {
      "mf": { "kind": "must_find", "file": "src/a.ts", "start_line": 9, "end_line": 10, "severity": "WARNING", "category": "bug", "title": "T" },
      "mnf": { "kind": "must_not_flag", "file": "src/a.ts", "start_line": 9, "end_line": 10, "severity": null, "category": null, "title": null }
    },
    "finding": { "id": "x", "severity": "WARNING", "category": "bug", "title": "Finding", "file": "src/a.ts", "start_line": 9, "end_line": 10, "rationale": "because", "suggestion": null, "confidence": 0.8, "kind": "finding", "out_of_scope": null },
    "scenarios": [
      { "name": "mixed outcomes with skills, description and cost",
        "job": { "caseIds": ["c1", "c2", "c3", "c4"], "config": { "skills": ["$skills"] } },
        "cases": {
          "c1": { "expect": "mf", "diff": "single", "meta": { "pr_description": "Closes the crash.", "pr_number": 7, "repo": "acme/api", "head_sha": "abc" } },
          "c2": { "expect": "mnf", "diff": "single", "meta": { "pr_number": null } },
          "c3": { "expect": "mf", "diff": "two", "meta": {} },
          "c4": { "expect": "mf", "diff": "single", "meta": {} }
        },
        "script": {
          "c1": [{ "cost": 0.001, "findings": [{ "title": "Hit", "start_line": 9, "end_line": 9 }, { "title": "Elsewhere", "start_line": 11, "end_line": 12 }, { "title": "Phantom", "start_line": 500, "end_line": 501 }] }],
          "c2": [{ "cost": 0.002, "findings": [{ "title": "Violation", "start_line": 10, "end_line": 10 }] }],
          "c3": [{ "cost": null, "findings": [] }],
          "c4": [{ "costOnError": 0.0005, "error": "OpenRouter returned no choices for Review" }]
        } },
      { "name": "strategies: unknown values fall back to auto",
        "job": { "caseIds": ["c1"] },
        "strategyVariants": ["map-reduce", "fancy", "", "MAP-REDUCE", "auto", "single-pass"],
        "cases": { "c1": { "expect": "mf", "diff": "two", "meta": {} } },
        "script": { "c1": [{ "cost": 0.001, "findings": [{ "title": "A", "start_line": 2, "end_line": 2, "file": "src/a.ts" }] }, { "cost": 0.002, "findings": [{ "title": "B", "start_line": 20, "end_line": 21, "file": "src/b.ts" }] }] } },
      { "name": "a large multi-file diff under auto runs map-reduce",
        "job": { "caseIds": ["c1"], "config": { "strategy": "auto" } },
        "cases": { "c1": { "expect": "mf", "diff": "manyFilesLarge", "meta": {} } },
        "script": { "c1": [
          { "cost": 0.0001, "findings": [{ "title": "A", "start_line": 9, "end_line": 10, "file": "src/a.ts" }] },
          { "cost": 0.0002, "findings": [{ "title": "B", "start_line": 150, "end_line": 151, "file": "src/b.ts" }, { "title": "Out", "start_line": 900, "end_line": 901, "file": "src/b.ts" }] },
          { "cost": null, "findings": [] }
        ] } },
      { "name": "every case errored with the same text",
        "job": { "caseIds": ["c1", "c2"] },
        "cases": { "c1": { "expect": "mf", "diff": "single", "meta": {} }, "c2": { "expect": "mnf", "diff": "single", "meta": {} } },
        "script": { "c1": [{ "error": "  provider   said\n\n no  " }], "c2": [{ "error": "  provider   said\n\n no  " }] } },
      { "name": "a single errored case",
        "job": { "caseIds": ["c1"] },
        "cases": { "c1": { "expect": "mf", "diff": "single", "meta": {} } },
        "script": { "c1": [{ "error": "", "costOnError": 0.25 }] } },
      { "name": "error text is cut at 500",
        "job": { "caseIds": ["c1"] },
        "cases": { "c1": { "expect": "mf", "diff": "single", "meta": {} } },
        "script": { "c1": [{ "error": { "$repeat": ["very long error ", 80] } }] } },
      { "name": "a deleted case is dropped",
        "job": { "caseIds": ["c1", "c2", "c3"] },
        "cases": { "c1": { "expect": "mf", "diff": "single", "meta": {} }, "c2": null, "c3": { "expect": "mnf", "diff": "single", "meta": {} } },
        "script": { "c1": [{ "cost": 0.001, "findings": [{ "title": "Hit", "start_line": 9, "end_line": 9 }] }], "c3": [{ "cost": 0.001, "findings": [] }] } },
      { "name": "every case deleted completes with null metrics",
        "job": { "caseIds": ["c1", "c2"] },
        "cases": { "c1": null, "c2": null },
        "script": {} },
      { "name": "no cases at all",
        "job": { "caseIds": [] },
        "cases": {},
        "script": {} },
      { "name": "recording says the case is gone",
        "job": { "caseIds": ["c1", "c2"] },
        "cases": { "c1": { "expect": "mf", "diff": "single", "meta": {} }, "c2": { "expect": "mf", "diff": "single", "meta": {} } },
        "script": { "c1": [{ "cost": 0.001, "findings": [] }], "c2": [{ "cost": 0.002, "findings": [{ "title": "Hit", "start_line": 9, "end_line": 9 }] }] },
        "recordGone": ["c1"] },
      { "name": "a store failure while recording stops further cases",
        "job": { "caseIds": ["c1", "c2", "c3", "c4", "c5"] },
        "cases": {
          "c1": { "expect": "mf", "diff": "single", "meta": {} }, "c2": { "expect": "mf", "diff": "single", "meta": {} }, "c3": { "expect": "mf", "diff": "single", "meta": {} },
          "c4": { "expect": "mf", "diff": "single", "meta": {} }, "c5": { "expect": "mf", "diff": "single", "meta": {} }
        },
        "script": { "c1": [{ "cost": 0.001, "findings": [] }], "c2": [{ "cost": 0.001, "findings": [] }], "c3": [{ "cost": 0.001, "findings": [] }], "c4": [{ "cost": 0.001, "findings": [] }], "c5": [{ "cost": 0.001, "findings": [] }] },
        "recordFail": { "c1": "connection terminated" } },
      { "name": "a store failure while loading a case",
        "job": { "caseIds": ["c1", "c2", "c3", "c4"] },
        "cases": { "c1": { "expect": "mf", "diff": "single", "meta": {} }, "c2": { "expect": "mf", "diff": "single", "meta": {} }, "c3": { "expect": "mf", "diff": "single", "meta": {} }, "c4": { "expect": "mf", "diff": "single", "meta": {} } },
        "script": { "c2": [{ "cost": 0.001, "findings": [] }], "c3": [{ "cost": 0.001, "findings": [] }], "c4": [{ "cost": 0.001, "findings": [] }] },
        "loadFail": { "c1": "load failed" } },
      { "name": "a hanging case hits the 120 s budget",
        "job": { "caseIds": ["c1", "c2"] },
        "cases": { "c1": { "expect": "mf", "diff": "single", "meta": {} }, "c2": { "expect": "mf", "diff": "single", "meta": {} } },
        "script": { "c1": [{ "hang": true, "cost": 0.003 }], "c2": [{ "cost": 0.001, "findings": [{ "title": "Hit", "start_line": 9, "end_line": 9 }] }] },
        "steps": [{ "settle": true }, { "fire": 120000 }, { "waitFinish": true }] },
      { "name": "the finish is written even when the final state write fails",
        "job": { "caseIds": ["c1"] },
        "cases": { "c1": { "expect": "mf", "diff": "single", "meta": {} } },
        "script": { "c1": [{ "cost": 0.001, "findings": [] }] },
        "finishFail": "write failed" },
      { "name": "shutdown while cases are in flight",
        "job": { "caseIds": ["c1", "c2", "c3", "c4"] },
        "cases": { "c1": { "expect": "mf", "diff": "single", "meta": {} }, "c2": { "expect": "mf", "diff": "single", "meta": {} }, "c3": { "expect": "mf", "diff": "single", "meta": {} }, "c4": { "expect": "mf", "diff": "single", "meta": {} } },
        "script": { "c1": [{ "hang": true, "cost": 0.003 }], "c2": [{ "cost": 0.001, "findings": [] }], "c3": [{ "hang": true }], "c4": [{ "cost": 0.001, "findings": [] }] },
        "steps": [{ "settle": true }, { "shutdown": 5000 }, { "waitFinish": true }] },
      { "name": "a skill run carries the skill in the config",
        "job": { "ownerKind": "skill", "skillId": "sk-1", "skillVersion": 2, "caseIds": ["c1"], "config": { "skills": ["$skill1"] } },
        "cases": { "c1": { "expect": "mf", "diff": "single", "meta": { "pr_description": "  has text  " } } },
        "script": { "c1": [{ "cost": 0.0123456789, "findings": [{ "title": "Hit", "start_line": 9, "end_line": 9 }] }] } }
    ]
  },
  "runsService": [
    { "name": "start: unknown agent",
      "world": { "agents": {} },
      "steps": [{ "op": "start", "agentId": "nope" }] },
    { "name": "start: no cases",
      "world": { "agents": { "agent-1": {} }, "caseIds": {} },
      "steps": [{ "op": "start", "agentId": "agent-1" }] },
    { "name": "start: creates, launches and answers",
      "world": { "agents": { "agent-1": { "config": { "skills": ["$skill1", "$skill2"] } } }, "caseIds": { "agent:agent-1": ["c1", "c2", "c3"] } },
      "steps": [{ "op": "start", "agentId": "agent-1" }] },
    { "name": "start: a run is already active",
      "world": { "agents": { "agent-1": {} }, "caseIds": { "agent:agent-1": ["c1"] }, "active": ["agent:agent-1"] },
      "steps": [{ "op": "start", "agentId": "agent-1" }] },
    { "name": "startSkill: unknown skill",
      "world": { "agents": { "agent-1": {} }, "skills": {} },
      "steps": [{ "op": "startSkill", "skillId": "nope", "hostAgentId": "agent-1" }] },
    { "name": "startSkill: unknown host agent",
      "world": { "agents": {}, "skills": { "skill-1": {} } },
      "steps": [{ "op": "startSkill", "skillId": "skill-1", "hostAgentId": "nope" }] },
    { "name": "startSkill: no cases",
      "world": { "agents": { "agent-1": {} }, "skills": { "skill-1": {} }, "caseIds": {} },
      "steps": [{ "op": "startSkill", "skillId": "skill-1", "hostAgentId": "agent-1" }] },
    { "name": "startSkill: the host's own skills are replaced by exactly the skill",
      "world": { "agents": { "agent-1": { "config": { "skills": ["$skill1", "$skill2"] } } }, "skills": { "skill-1": { "id": "skill-1", "name": "api-safety", "description": "d", "body": "b", "version": 4 } }, "caseIds": { "skill:skill-1": ["c1", "c2"] } },
      "steps": [{ "op": "startSkill", "skillId": "skill-1", "hostAgentId": "agent-1" }] },
    { "name": "startSkill: a run is already active",
      "world": { "agents": { "agent-1": {} }, "skills": { "skill-1": {} }, "caseIds": { "skill:skill-1": ["c1"] }, "active": ["skill:skill-1"] },
      "steps": [{ "op": "startSkill", "skillId": "skill-1", "hostAgentId": "agent-1" }] },
    { "name": "runAll: started and skipped in agent order",
      "world": { "agents": { "agent-a": {}, "agent-b": {}, "agent-c": {}, "agent-d": {} }, "caseIds": { "agent:agent-a": ["c1"], "agent:agent-c": ["c2"], "agent:agent-d": ["c3", "c4"] }, "active": ["agent:agent-c"] },
      "steps": [{ "op": "runAll" }] },
    { "name": "runAll: no agents",
      "world": { "agents": {} },
      "steps": [{ "op": "runAll" }] },
    { "name": "runAll: an agent that vanishes mid-way fails the whole call",
      "world": { "agents": { "agent-a": {}, "agent-b": {}, "agent-c": {} }, "caseIds": { "agent:agent-a": ["c1"], "agent:agent-b": ["c2"], "agent:agent-c": ["c3"] }, "vanish": ["agent-b"] },
      "steps": [{ "op": "runAll" }] },
    { "name": "list: unknown agent, plain, with periods",
      "world": { "agents": { "agent-1": {} }, "now": "2026-03-31T12:00:00.000Z" },
      "steps": [{ "op": "list", "agentId": "nope", "limit": 20 }, { "op": "list", "agentId": "agent-1", "limit": 20 }, { "op": "list", "agentId": "agent-1", "limit": 5, "period": "7d" }, { "op": "list", "agentId": "agent-1", "limit": 100, "period": "30d" }, { "op": "list", "agentId": "agent-1", "limit": 1, "period": "90d" }, { "op": "list", "agentId": "agent-1", "limit": 20, "period": "all" }] },
    { "name": "listSkillRuns: unknown and known skill",
      "world": { "skills": { "skill-1": {} } },
