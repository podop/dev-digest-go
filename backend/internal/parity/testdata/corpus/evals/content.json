    "newFile": { "lines": ["diff --git a/src/new.ts b/src/new.ts", "new file mode 100644", "--- /dev/null", "+++ b/src/new.ts", "@@ -0,0 +1,3 @@", "+a", "+b", "+c"] },
    "noCounts": { "lines": ["diff --git a/src/a.ts b/src/a.ts", "--- a/src/a.ts", "+++ b/src/a.ts", "@@ -3 +3 @@", "-old", "+new"] },
