    "noNewlineMarker": { "lines": ["diff --git a/src/a.ts b/src/a.ts", "--- a/src/a.ts", "+++ b/src/a.ts", "@@ -1,2 +1,2 @@", "-old", "\\ No newline at end of file", "+new", "\\ No newline at end of file", " tail"] },
    "plusPlusPlusContent": { "lines": ["diff --git a/src/a.ts b/src/a.ts", "--- a/src/a.ts", "+++ b/src/a.ts", "@@ -1,2 +1,3 @@", " one", "+++ added line starting with plus plus", "---removed line starting with minus minus", " two"] },
