        { "req": { "method": "GET", "url": "/agents/performance?period=custom" } },
        { "req": { "method": "GET", "url": "/agents/performance?period=custom&from=2026-01-02T00:00:00Z&to=2026-01-01T00:00:00Z" } },
        { "req": { "method": "GET", "url": "/agents/performance?period=custom&from=2026-01-01T00:00:00Z&to=2027-01-03T00:00:00Z" } },
        { "req": { "method": "GET", "url": "/agents/performance?period=custom&from=2026-01-01&to=2026-01-05T00:00:00Z" } },
        { "req": { "method": "GET", "url": "/agents/performance?period=1d&period=30d" } },
        { "req": { "method": "GET", "url": "/agents/performance?foo=bar&period=1d" } },
        { "req": { "method": "GET", "url": "/agents/performance?period=custom&from=2026-03-20T00%3A00%3A00Z&to=2026-03-30T00%3A00%3A00Z" } },
        { "req": { "method": "GET", "url": "/agents/performance?period=custom&from=2026-03-20T00:00:00%2B05:30&to=2026-03-30T00:00:00Z" } },
        { "req": { "method": "GET", "url": "/agents/performance?period=custom&from=2026-03-20T00:00:00+05:30&to=2026-03-30T00:00:00Z" } },
        { "req": { "method": "GET", "url": "/agents/performance?period=custom&from=2026-03-20T00:00:00%2B24:00&to=2026-03-30T00:00:00Z" } },
        { "req": { "method": "GET", "url": "/agents/performance?period=" } },
        { "req": { "method": "GET", "url": "/agents/{agent}/stats" } },
        { "req": { "method": "GET", "url": "/agents/{agent}/stats?period=1d" } },
        { "req": { "method": "GET", "url": "/agents/{bug}/stats?period=30d" } },
        { "req": { "method": "GET", "url": "/agents/{zed}/stats?period=30d" } },
        { "req": { "method": "GET", "url": "/agents/{unknownAgent}/stats" } },
        { "req": { "method": "GET", "url": "/agents/{foreign}/stats" } },
        { "req": { "method": "GET", "url": "/agents/performance/stats" } },
        { "req": { "method": "GET", "url": "/agents/not-a-uuid/stats" } },
