{
  "note": "sliceDiff(parseUnifiedDiff(raw), path) for every path in `paths`; `paths` may name files the diff does not contain. `fileLabels` in the golden are the parsed file paths (what the engine uses as map chunk labels).",
  "cases": [
    {
      "name": "similar_names_are_not_substrings",
      "lines": [
        "diff --git a/src/a.ts b/src/a.ts",
        "--- a/src/a.ts",
        "+++ b/src/a.ts",
        "@@ -1 +1 @@",
        "-1",
        "+2",
        "diff --git a/src/a.tsx b/src/a.tsx",
        "--- a/src/a.tsx",
        "+++ b/src/a.tsx",
        "@@ -1 +1 @@",
        "-x",
        "+y"
      ],
      "paths": ["src/a.ts", "src/a.tsx", "a.ts"]
    },
    {
      "name": "rename_matches_new_path_first_then_old",
      "lines": [
        "diff --git a/old.ts b/new.ts",
        "similarity index 80%",
        "rename from old.ts",
        "rename to new.ts",
        "--- a/old.ts",
        "+++ b/new.ts",
        "@@ -1,2 +1,2 @@",
        " k",
        "-a",
        "+b",
        "diff --git a/zzz.ts b/zzz.ts",
        "--- a/zzz.ts",
        "+++ b/zzz.ts",
        "@@ -1 +1 @@",
        "-p",
        "+q"
      ],
      "paths": ["new.ts", "old.ts", "zzz.ts"]
    },
    {
      "name": "quoted_header_with_spaces_and_escapes",
      "lines": [
        "diff --git \"a/my dir/f.ts\" \"b/my dir/f.ts\"",
        "--- \"a/my dir/f.ts\"",
        "+++ \"b/my dir/f.ts\"",
        "@@ -1 +1 @@",
        "-a",
        "+b",
        "diff --git \"a/we\\\"ird\\\\name.ts\" \"b/we\\\"ird\\\\name.ts\"",
        "--- \"a/we\\\"ird\\\\name.ts\"",
        "+++ \"b/we\\\"ird\\\\name.ts\"",
        "@@ -2 +2 @@",
        "-c",
        "+d"
      ],
      "paths": ["my dir/f.ts", "we\"ird\\name.ts", "\"b/my dir/f.ts\""]
    },
    {
      "name": "unquoted_header_with_spaces",
      "lines": [
        "diff --git a/my dir/f.ts b/my dir/f.ts",
        "--- a/my dir/f.ts",
        "+++ b/my dir/f.ts",
        "@@ -1 +1 @@",
        "-a",
        "+b",
        "diff --git a/old name.ts b/new name.ts",
        "--- a/old name.ts",
        "+++ b/new name.ts",
        "@@ -1 +1 @@",
        "-c",
        "+d"
      ],
      "paths": ["my dir/f.ts", "new name.ts", "old name.ts"]
    },
    {
      "name": "no_diff_git_header_rebuilds_the_hunk_headers",
      "lines": [
        "--- a/solo.ts",
        "+++ b/solo.ts",
        "@@ -1,2 +1,3 @@",
        " a",
        "+b",
        " c",
        "@@ -9 +10 @@",
        "-x",
        "+y"
      ],
      "paths": ["solo.ts"]
    },
    {
      "name": "unknown_path_returns_the_whole_diff",
      "lines": [
        "diff --git a/a.ts b/a.ts",
        "--- a/a.ts",
        "+++ b/a.ts",
        "@@ -1 +1 @@",
        "-1",
        "+2"
      ],
      "paths": ["missing.ts"]
    },
    {
      "name": "unparsable_header_is_skipped",
      "lines": [
        "diff --git weird header",
        "--- a/x.ts",
        "+++ b/x.ts",
        "@@ -1 +1 @@",
        "-1",
        "+2",
        "diff --git a/y.ts b/y.ts",
        "--- a/y.ts",
        "+++ b/y.ts",
        "@@ -1 +1 @@",
        "-3",
        "+4"
      ],
      "paths": ["x.ts", "y.ts"]
    },
    {
      "name": "trailing_newline_stays_in_the_last_section",
      "trailingEol": true,
      "lines": [
        "diff --git a/a.ts b/a.ts",
        "--- a/a.ts",
        "+++ b/a.ts",
        "@@ -1 +1 @@",
        "-1",
        "+2",
        "diff --git a/b.ts b/b.ts",
        "--- a/b.ts",
        "+++ b/b.ts",
        "@@ -1 +1 @@",
        "-3",
        "+4"
      ],
      "paths": ["a.ts", "b.ts"]
    },
    {
      "name": "crlf_headers",
      "eol": "\r\n",
      "lines": [
        "diff --git a/w.ts b/w.ts",
        "--- a/w.ts",
        "+++ b/w.ts",
        "@@ -1 +1 @@",
        "-1",
        "+2",
        "diff --git a/v.ts b/v.ts",
        "--- a/v.ts",
        "+++ b/v.ts",
        "@@ -1 +1 @@",
        "-3",
        "+4"
      ],
      "paths": ["w.ts", "v.ts"]
    }
  ]
}
