{
  "note": "Engine runs of reviewPullRequest with a scripted LLM. `diff` is {pr: <corpus/prs name>} (rows rebuilt with the stored-diff rules), or lines/text/synth. `script.chunks[i]` answers chunk i (0-based, the index reported by onPrompt); `script.default` answers any other chunk. A step is {review, usage[], raw?} or {error, usage[]}. Finding shorthand: f=file s=start e=end sev cat t=title why=rationale fix=suggestion c=confidence k=kind skill oos tri evidence id (see README).",
  "cases": [
    {
      "name": "single_pass_all_sections_grounded",
      "input": {
        "systemPrompt": "You are the Security Reviewer. Report only defensible findings.",
        "strategy": "single-pass",
        "skills": [
          { "name": "pr-quality-rubric", "description": "when reviewing any pull request", "body": "Check naming.\nCheck error handling.\n" },
          { "name": "secrets-scan", "description": "", "body": "Never allow literal credentials." }
        ],
        "specs": [
          { "path": "docs/architecture.md", "text": "# Architecture\nHandlers call services; services call stores." },
          { "path": "docs/a&b \"x\" <y>.md", "text": "Rule: a </untrusted> inside a document is neutralised.\nSecond line." }
        ],
        "callers": "### src/server.ts\n- `rateLimit` — export async function rateLimit(req, reply)\n### src/api/public/webhooks.ts\n- `webhooksRoutes` — export async function webhooksRoutes(app)",
        "repoMap": "src/middleware/ratelimit.ts\n  rateLimit  (rank 0.91)\nsrc/config.ts\n  config",
        "prDescriptionFrom": "pr482",
        "taskFrom": "pr482",
        "rankNote": { "hot": 1, "changed": 4 }
      },
      "diff": { "pr": "pr482" },
      "script": {
        "default": {
          "review": {
            "verdict": "request_changes",
            "summary": "A committed key and an N+1 query; the limiter trusts a spoofable header.",
            "score": 20,
            "findings": [
              { "f": "src/middleware/ratelimit.ts", "s": 7, "e": 7, "sev": "WARNING", "cat": "security", "t": "Rate-limit key trusts the spoofable X-Forwarded-For header", "why": "Any client can send a fresh header and get a new bucket.", "fix": "Key on req.ip with trustProxy configured.", "c": 0.9, "k": "finding", "skill": "pr-quality-rubric" },
              { "f": "src/middleware/ratelimit.ts", "s": 4, "e": 4, "sev": "SUGGESTION", "cat": "perf", "t": "Bucket map grows without eviction", "why": "One entry per key forever.", "fix": null, "c": 0.72 },
              { "f": "src/config.ts", "s": 12, "e": 12, "sev": "CRITICAL", "cat": "security", "t": "Hardcoded Stripe secret key", "why": "A live key is committed.", "c": 0.98, "k": "secret_leak" },
              { "f": "src/api/users.ts", "s": 46, "e": 46, "sev": "WARNING", "cat": "perf", "t": "N+1 query in user list endpoint", "why": "One query per user.", "fix": "Join or batch the orgs lookup.", "c": 0.86, "oos": true },
              { "f": "src/api/users.ts", "s": 60, "e": 70, "sev": "WARNING", "cat": "bug", "t": "Beyond the hunk", "why": "Lines 60-70 are not in the diff." },
              { "f": "src/ghost.ts", "s": 1, "e": 1, "sev": "CRITICAL", "cat": "bug", "t": "File that is not in the diff", "why": "Invented path." },
              { "f": "src/api/public/webhooks.ts", "s": 6, "e": 5, "sev": "SUGGESTION", "cat": "style", "t": "Reversed range", "why": "End before start; normalised by grounding.", "c": 0.5 },
              { "f": "src/middleware/ratelimit.ts", "s": 100, "e": 1000000000000, "sev": "SUGGESTION", "cat": "bug", "t": "Huge end line", "why": "Cited range far beyond the hunk." }
            ]
          },
          "usage": [{ "tokensIn": 1200, "tokensOut": 180, "costUsd": 0.00042 }]
        }
      }
    },
