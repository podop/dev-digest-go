    {
      "name": "openrouter_success_first_attempt",
      "provider": "openrouter",
      "temperature": 0,
      "maxRetries": 2,
      "sessionId": "acme/payments-api#482:Security Reviewer",
      "responses": [
        {
          "content": "{\"verdict\": \"comment\", \"summary\": \"ok\", \"score\": 50, \"findings\": []}",
          "usage": {"prompt_tokens": 1200, "completion_tokens": 180, "cost": 0.00042}
        }
      ],
      "runs": [
        {
          "model": "deepseek/deepseek-v4-flash",
          "requests": [
            {
              "path": "/v1/chat/completions",
              "authorization": "Bearer sk-test-key",
              "body": {
                "model": "deepseek/deepseek-v4-flash",
                "messages": [
                  {"role": "system", "content": "SYSTEM"},
                  {"role": "user", "content": "USER"}
                ],
                "temperature": 0,
                "response_format": "$strictReview",
                "session_id": "acme/payments-api#482:Security Reviewer",
                "usage": {"include": true}
              }
            }
          ],
          "usage": [
            {"tokensIn": 1200, "tokensOut": 180, "costUsd": 0.00042}
          ],
          "warnings": [],
          "result": {
            "data": {
              "verdict": "comment",
              "summary": "ok",
              "score": 50,
              "findings": []
            },
            "model": "deepseek/deepseek-v4-flash",
            "tokensIn": 1200,
            "tokensOut": 180,
            "costUsd": 0.00042,
            "raw": "{\"verdict\": \"comment\", \"summary\": \"ok\", \"score\": 50, \"findings\": []}",
            "attempts": 1
